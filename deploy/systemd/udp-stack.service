[Unit]
Description=Urbane Datenplattform (FIWARE-Stack, docker compose)
Documentation=file://__UDP_ROOT__/README.md
# User-Units können nicht auf System-Units (docker.service) warten –
# daher aktives Warten auf den Docker-Socket im ExecStartPre.
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__UDP_ROOT__/platform
# Bis zu 120 s auf den (rootful) Docker-Daemon warten
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do /usr/bin/docker info >/dev/null 2>&1 && exit 0; sleep 2; done; echo "Docker-Daemon nicht erreichbar" >&2; exit 1'
ExecStart=/usr/bin/docker compose --profile viz-extra --profile analytics up -d --remove-orphans
ExecStop=/usr/bin/docker compose --profile viz-extra --profile analytics stop
TimeoutStartSec=900

[Install]
WantedBy=default.target
