# Host-Port.
KUMA_PORT=3701      # Uptime Kuma (kein Subpath-Support)

# Zugangsdaten legt Uptime Kuma beim ERSTEN Aufruf selbst an (Setup-Assistent
# im Browser) – es gibt bewusst keine Umgebungsvariable dafür. Den Dienst
# deshalb nicht ungeschützt ins Internet stellen, bevor das Konto steht.
