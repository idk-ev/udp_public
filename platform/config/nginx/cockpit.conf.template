# UDP-Cockpit – Auslieferung der SPA + Reverse-Proxy auf das API-Gateway,
# damit die GUI ohne CORS-Sonderfälle unter einem Origin läuft.
#
# .template, weil der nginx-Entrypoint (20-envsubst-on-templates.sh) alles
# unter /etc/nginx/templates/ durch envsubst schickt. Ersetzt werden NUR
# Variablen mit dem Präfix UDP_ (NGINX_ENVSUBST_FILTER) – die nginx-eigenen
# $-Variablen ($uri, $host, …) bleiben unangetastet.
#
#   NGINX_LOCAL_RESOLVERS  Nameserver aus /etc/resolv.conf – der nginx-Entrypoint
#                          setzt die Variable selbst, sobald
#                          NGINX_ENTRYPOINT_LOCAL_RESOLVERS gesetzt ist. Damit
#                          stimmt der Resolver in Docker (127.0.0.11) UND in
#                          Kubernetes (Cluster-DNS), ohne ihn zu pflegen.
#   UDP_GATEWAY_UPSTREAM    host:port von APISIX
#   UDP_CONNECTORS_UPSTREAM host:port des Konnektordienstes (/abfahrten,
#                           /warnungen.ics); geprüft von
#                           gui/docker/17-udp-upstreams.envsh
#
# In Kubernetes MÜSSEN die Upstreams voll qualifiziert sein
# (apisix.<ns>.svc.cluster.local): nginx wendet auf Namen, die es über den
# resolver auflöst, die search-Domains aus /etc/resolv.conf NICHT an – "apisix"
# allein bliebe unauflösbar und jede Gateway-Anfrage liefe in einen 502.

# Micro-Cache (F5): schützt Orion/Mintaka und die offenen Upstreams bei
# öffentlichem Traffic; 60 s Kontext / 300 s Zeitreihen genügen den Takten.
proxy_cache_path /var/cache/nginx/udp levels=1:2 keys_zone=udpapi:10m
                 max_size=100m inactive=15m use_temp_path=off;
# Routes of the connector service (/abfahrten, /warnungen.ics): own zone with
# a long "inactive" – the stale copy that bridges an outage of that single
# instance must still exist then. Calendar clients poll /warnungen.ics only every hour or so; with the
# 15 min of udpapi the entry would usually be gone exactly when it is needed.
proxy_cache_path /var/cache/nginx/connectors levels=1:2 keys_zone=udpconnectors:2m
                 max_size=20m inactive=24h use_temp_path=off;

# Per-client request limits for the two endpoints that reach the connector
# service (and through it EFA-BW resp. Orion-LD). Keyed by the client address
# after real_ip (see the server block), so the ingress hop does not share one
# bucket. A dashboard asks /abfahrten once per page view and minute; a
# calendar client polls /warnungen.ics every few hours. Beyond the burst: 429.
limit_req_zone $binary_remote_addr zone=udp_abfahrten:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=udp_warnungen:10m rate=10r/m;

server {
    # Client address behind the ingress controller / load balancer: take it
    # from X-Forwarded-For, skipping trusted proxy hops. The set_real_ip_from
    # directives come from UDP_TRUSTED_PROXIES (gui/docker/16-udp-realip.envsh,
    # default: all private ranges). Feeds X-Real-IP below, which keys the
    # per-client rate limit in APISIX.
    ${UDP_REALIP_FROM}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # 8080, nicht 80: das Image ist nginx-unprivileged und laeuft als Benutzer
    # 101. Ports unter 1024 brauchen CAP_NET_BIND_SERVICE, das in Kubernetes
    # mit "capabilities: drop: [ALL]" wegfaellt. Der Service vor dem Pod
    # veroeffentlicht weiterhin Port 80.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;  # Location-Header relativ lassen (Betrieb hinter Port/Proxy)

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Sicherheits-Header (BSI-Grundschutz-orientiert)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Startseite ist das öffentliche Mitmachen-Angebot, nicht das Cockpit.
    # Exakter Match, damit weder "index index.html" noch die Präfix-Location
    # weiter unten greift – und kein Redirect, damit die Domain selbst die
    # Seite ist. Die Cockpit-Übersicht liegt dafür unter /cockpit.
    location = / {
        expires -1;   # wie die übrigen HTML-Seiten: immer revalidieren
        try_files /mitmachen.html =404;
    }

    # Abgelöste Seiten (Konsolidierung 2026-07): alte Bookmarks sauber umleiten
    location = /kommunen.html { return 301 /dashboard.html; }
    location = /reutlingen_smartcity.html { return 301 /reutlingen; }
    location = /smartcity.html { return 301 /reutlingen; }

    # Stadtkreise haben keine eigene Kreisseite — ihr Kreis-Permalink führt aufs
    # Stadt-Dashboard (nur die 7 ohne gleichnamigen Landkreis; Heilbronn/Karlsruhe
    # sind echte Landkreis-Seiten).
    location = /kreis-stuttgart { return 301 /stuttgart; }
    location = /kreis-baden-baden { return 301 /baden-baden; }
    location = /kreis-heidelberg { return 301 /heidelberg; }
    location = /kreis-mannheim { return 301 /mannheim; }
    location = /kreis-pforzheim { return 301 /pforzheim; }
    location = /kreis-freiburg-im-breisgau { return 301 /freiburg-im-breisgau; }
    location = /kreis-ulm { return 301 /ulm; }

    # Statische Assets immer revalidieren (expires -1 => Cache-Control: no-cache):
    # Palette-/Template-Änderungen kommen so ohne Hard-Reload an; ETag greift,
    # und die server-weiten Security-Header bleiben vererbt.
    location ~* \.(css|js|html|json)$ {
        expires -1;
        try_files $uri =404;
    }

    # Operator logo and favicon (Helm: cockpit.branding -> ConfigMap
    # cockpit-branding mounted here; Compose: gui/public/branding/ in the
    # build). Uploaded images may be SVG: opened directly, an SVG is a
    # document that could run script on this origin. The CSP sandbox forbids
    # that (inline styles stay allowed for SVGs that use them); <img> never
    # runs SVG script anyway. add_header here drops the server-level headers,
    # so they are repeated.
    location ^~ /branding/ {
        expires -1;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
        try_files $uri =404;
    }
    # Stable favicon address for every page: the operator's favicon if one is
    # mounted, else the platform icon. The Content-Type follows the file that
    # matched (try_files re-derives the extension). The PWA manifest keeps
    # /icon.svg – installable apps need a large, scalable icon.
    location = /favicon {
        expires -1;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
        try_files /branding/favicon.png /branding/favicon.svg /branding/favicon.ico /icon.svg =404;
    }

    # PWA-Manifest mit korrektem MIME-Typ ausliefern (Installierbarkeit).
    location = /manifest.webmanifest {
        types { } default_type application/manifest+json;
        expires -1;
        try_files $uri =404;
    }
    # Warnungen als iCal-Abo (Konnektordienst). 5 min Cache — Kalender ziehen ohnehin selten.
    # Cache key and upstream request carry ONLY kreis: extra or repeated
    # parameters neither bypass the cache nor reach the upstream (one cache
    # entry per district, whatever else a client appends).
    location = /warnungen.ics {
        limit_except GET HEAD OPTIONS { deny all; }
        limit_req zone=udp_warnungen burst=10 nodelay;
        limit_req_status 429;
        set $connectors http://${UDP_CONNECTORS_UPSTREAM};
        proxy_pass $connectors/warnungen.ics?kreis=$arg_kreis;
        proxy_set_header Host $host;
        proxy_cache udpconnectors;
        proxy_cache_valid 200 300s;
        proxy_cache_key "$uri?kreis=$arg_kreis";
        proxy_cache_lock on;
        # The connector service runs as a single instance: while it restarts
        # (rollout, node drain) the last good calendar is served instead of an
        # error, and an expired entry is refreshed in the background. It
        # answers 503 while Orion is unreachable – served stale as well.
        proxy_cache_use_stale updating error timeout http_404 http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        # add_header here replaces the server-level headers; repeated.
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Cache $upstream_cache_status always;
    }

    # Der Service-Worker darf nicht veralten (sonst hängen Clients auf altem Cache).
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Interne SPA-Routen (Deep-Links des Cockpits) laufen auf die SPA.
    # /cockpit ist die frühere Startseite (Übersicht) – der Router kennt den
    # Pfad als eigene Route, deshalb reicht das Ausliefern der index.html.
    location ~ ^/(cockpit|daten|karte|zeitreihen|module|verwaltung)$ {
        try_files /index.html =404;
    }

    # Kommunen-Slugs (F2): /reutlingen -> /g/reutlingen/index.html.
    # Unbekannte Pfade sind ein echter 404 (kein Soft-404 auf die SPA mehr).
    error_page 404 /404.html;
    location / {
        try_files $uri $uri/ /g$uri/index.html =404;
    }

    # Plattform-APIs über das API-Gateway (APISIX).
    # Resolver + Variable im proxy_pass: der Upstream wird zur Laufzeit
    # aufgelöst, damit Neustarts des Gateways keinen Cockpit-Neustart
    # erfordern (ohne die Variable würde nginx beim Start hart scheitern,
    # wenn APISIX gerade nicht läuft).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Lesende Kontext-API: 60 s Micro-Cache
    # ^~ : verhindert, dass die Regex-Location für .css|.js|.html|.json weiter
    # oben greift und Gateway-Pfade mit solcher Endung aus dem Dateisystem
    # beantwortet (Regex schlägt sonst jeden Präfix-Treffer).
    location ^~ /gateway/ngsi-ld/ {
        limit_except GET HEAD OPTIONS { deny all; }
        set $gateway http://${UDP_GATEWAY_UPSTREAM};
        rewrite ^/gateway/(.*)$ /$1 break;
        proxy_pass $gateway;
        proxy_set_header Host $host;
        # Client address for the per-client rate limit in APISIX. Always SET,
        # never passed through – a client cannot choose its own bucket.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache udpapi;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 60s;
        # The tenant header selects a different database in Orion-LD; Accept
        # (json / ld+json / geo+json) and Link (@context) change the rendering.
        # Without them in the key, one client's variant is served to everyone.
        proxy_cache_key "$request_uri|$http_ngsild_tenant|$http_accept|$http_link";
        proxy_cache_lock on;
        # Stale-while-revalidate: an expired entry is answered at once while ONE
        # request refreshes it in the background, and during a short Orion-LD /
        # MongoDB outage the last good answer is served instead of an error.
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        add_header X-Cache $upstream_cache_status always;
    }
    # ÖPNV-Abfahrten auf Anfrage (Konnektordienst). 60 s Micro-Cache mit proxy_cache_lock:
    # Gleichzeitige Aufrufe desselben Halts werden zu einer einzigen Anfrage an
    # die EFA-BW-Auskunft zusammengefasst.
    # Exakter Match (nicht Präfix): sonst reichte /abfahrten/<beliebig> in den
    # Konnektordienst durch, der selbst keine Authentifizierung hat.
    # Cache key and upstream request carry ONLY ags: `?ags=…&x=<random>` used
    # to bypass the cache and hit EFA-BW on every request, and a repeated ags
    # could plant a 404 under another request's key.
    location = /abfahrten {
        limit_except GET HEAD OPTIONS { deny all; }
        limit_req zone=udp_abfahrten burst=30 nodelay;
        limit_req_status 429;
        set $connectors http://${UDP_CONNECTORS_UPSTREAM};
        proxy_pass $connectors/abfahrten?ags=$arg_ags;
        proxy_set_header Host $host;
        proxy_cache udpconnectors;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 60s;
        proxy_cache_valid 404 30s;
        proxy_cache_key "$uri?ags=$arg_ags";
        proxy_cache_lock on;
        # While the upstream is briefly unavailable (single instance: rollout,
        # node drain) the last good answer of this stop is served instead of
        # an error – with X-Cache: STALE. Departures carry clock times and a
        # "stand" timestamp, so a stale answer is visibly old rather than
        # wrong. Stops without a cached answer get the error itself – not
        # cached, so the next request after recovery is answered again.
        # http_404 is in the list so a 404 of a restarting upstream never
        # overwrites the last good answer; an unknown stop has no stale entry
        # and still gets its (briefly cached) 404.
        proxy_cache_use_stale updating error timeout http_404 http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        # add_header here replaces the server-level headers; repeated.
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Cache $upstream_cache_status always;
    }

    # Zeitreihen: 300 s
    location ^~ /gateway/temporal/ {
        limit_except GET HEAD OPTIONS { deny all; }
        set $gateway http://${UDP_GATEWAY_UPSTREAM};
        rewrite ^/gateway/(.*)$ /$1 break;
        proxy_pass $gateway;
        proxy_set_header Host $host;
        # Client address for the per-client rate limit in APISIX. Always SET,
        # never passed through – a client cannot choose its own bucket.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache udpapi;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 300s;
        # Tenant, Accept and Link change the answer – s. /gateway/ngsi-ld/.
        proxy_cache_key "$request_uri|$http_ngsild_tenant|$http_accept|$http_link";
        proxy_cache_lock on;
        # Stale-while-revalidate: an expired entry is answered at once while ONE
        # request refreshes it in the background, and during a short Orion-LD /
        # MongoDB outage the last good answer is served instead of an error.
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        add_header X-Cache $upstream_cache_status always;
    }

    # Öffentlich erreichbar ist die Plattform-API AUSSCHLIESSLICH lesend: die
    # Routen hinter dem Gateway sind (noch) nicht per OIDC abgesichert, ein
    # anonymes POST/PATCH/DELETE würde direkt in den Context Broker schreiben.
    # Schreibende Nutzung läuft bis dahin cluster-intern gegen apisix:9080.
    location ^~ /gateway/ {
        limit_except GET HEAD OPTIONS { deny all; }
        set $gateway http://${UDP_GATEWAY_UPSTREAM};
        rewrite ^/gateway/(.*)$ /$1 break;
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
