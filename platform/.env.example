# Host-Ports. Alle weiteren Dienste laufen intern bzw. über den Proxy (APISIX).
UI_PORT=3700        # UDP-Cockpit
WORKFLOW_PORT=4900  # Node-RED
DB_PORT=5439        # PostgreSQL/PostGIS (TRoE)
APP_PORT=8700       # Keycloak
PROXY_PORT=8780     # APISIX API-Gateway
# APISIX nur lokal veröffentlicht (Rate-Limit vertraut X-Real-IP vom Cockpit).
# 0.0.0.0 öffnet es für andere Rechner – dann umgeht ein Client das Limit.
#PROXY_BIND=127.0.0.1
SUPERSET_PORT=8781  # Superset (Profil analytics, kein Subpath-Support)
# 3701 = Uptime Kuma – eigenes Deployment, s. monitoring/.env.example

# Zugangsdaten der Plattform. Diese Datei liefert BEWUSST keine Vorgabewerte:
# jeder Wert muss vor dem ersten Start selbst gesetzt werden. Der Stack erzwingt
# das über ${VAR:?…} in docker-compose.yml — ohne Wert bricht der Start ab.
# Für Produktion über Secret-Management (z. B. Sealed Secrets / Vault) bereitstellen.
#
# Passwörter erzeugen, z. B.:  openssl rand -base64 24
POSTGRES_USER=
POSTGRES_PASSWORD=

KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

CKAN_ADMIN_USER=
CKAN_ADMIN_PASSWORD=

SUPERSET_ADMIN=
SUPERSET_ADMIN_PASSWORD=
# Signiert Superset-Sessions — muss ein zufälliger, geheimer Wert sein.
SUPERSET_SECRET_KEY=

# Passantenfrequenz hystreet.com (kostenlose Registrierung); leer = Flow inaktiv
HYSTREET_API_TOKEN=

# Endpunkte /abfahrten und /warnungen.ics: leer = Node-RED. Nach der Umschaltung
# des jeweiligen Konnektors auf den Konnektordienst (runtime "app" in
# platform/config/connectors.json) hier connectors:1880 eintragen und das
# Cockpit neu starten; leeren ist der Rückweg (docs/migration-konnektoren.md).
#UDP_ABFAHRTEN_UPSTREAM=connectors:1880
#UDP_WARNUNGEN_UPSTREAM=connectors:1880

# Proxy-Netze vor dem Cockpit (Leerzeichen-getrennte CIDRs), deren
# X-Forwarded-For das Cockpit als Client-Adresse übernimmt — sie ist der
# Schlüssel des Rate-Limits in APISIX. Leer = alle privaten Bereiche
# (10/8, 172.16/12, 192.168/16). Auf das Netz des eigenen Reverse-Proxys
# einengen, sobald Clients selbst mit privater Absenderadresse ankommen: aus
# LAN/VPN, über den docker-proxy (Absender = Bridge-Gateway) oder bei rootless
# Docker — sonst wählt jeder solche Client per X-Forwarded-For seinen
# Rate-Limit-Topf selbst.
#UDP_TRUSTED_PROXIES=10.0.5.0/24
