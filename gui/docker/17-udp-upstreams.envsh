#!/bin/sh
# SPDX-License-Identifier: EUPL-1.2
# © 2024–2026 Thomas Kieß and contributors
#
# Sourced by the nginx entrypoint before the templates are rendered: the
# upstreams of /abfahrten and /warnungen.ics (cockpit.conf.template).
#
#   UDP_ABFAHRTEN_UPSTREAM  host:port serving /abfahrten
#   UDP_WARNUNGEN_UPSTREAM  host:port serving /warnungen.ics
#
# Unset or empty, both follow UDP_NODERED_UPSTREAM. Pointing one at the
# connector service (connectors:1880 in Compose, the fully qualified service
# name in Kubernetes) is the cutover of that endpoint; clearing it again is the
# way back (docs/migration-konnektoren.md, phase 4).
#
# A value that is set but is not host:port stops the container (non-zero exit
# of the entrypoint): after a cutover Node-RED no longer serves the endpoint, so
# silently falling back to it would answer from stale data. The check also
# keeps anything but host:port characters out of the nginx configuration.
: "${UDP_NODERED_UPSTREAM:=node-red:1880}"
export UDP_NODERED_UPSTREAM
for udp_name in UDP_ABFAHRTEN_UPSTREAM UDP_WARNUNGEN_UPSTREAM; do
    eval "udp_value=\${$udp_name:-}"
    if [ -z "$udp_value" ]; then
        udp_value="$UDP_NODERED_UPSTREAM"
    else
        # Exactly one colon, a non-empty host of [0-9A-Za-z._-], a numeric port.
        case "$udp_value" in
            *[!0-9A-Za-z.:_-]* | *:*:* | :* | *:) udp_valid=no ;;
            *:*)
                case "${udp_value##*:}" in
                    *[!0-9]*) udp_valid=no ;;
                    *) udp_valid=yes ;;
                esac ;;
            *) udp_valid=no ;;
        esac
        if [ "$udp_valid" != yes ]; then
            echo "17-udp-upstreams: ERROR: $udp_name must be host:port (e.g. connectors:1880) or empty for Node-RED, got '$udp_value' - refusing to start" >&2
            exit 1
        fi
    fi
    eval "export $udp_name=\"\$udp_value\""
    echo "17-udp-upstreams: $udp_name=$udp_value"
done
unset udp_name udp_value udp_valid
